{
  "platform": "${TV_PLATFORM}",
  "address": "${TV_ADDRESS}",
  "adb_path": "${ADB_PATH}",
  "timezone": "${TIMEZONE}",
  "poll_seconds": 2,
  "cooldown_seconds": 5,
  "action": "home",
  "rules": [
    {
      "name": "${RULE_NAME}",
      "enabled": true,
      "apps": [
        {
          "id": "${BLOCKED_APP_ID}",
          "name": "${BLOCKED_APP_NAME}"
        }
      ],
      "days": [
        "mon",
        "tue",
        "wed",
        "thu",
        "fri",
        "sat",
        "sun"
      ],
      "start": "00:00",
      "end": "00:00"
    }
  ]
}
